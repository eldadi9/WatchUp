APP_ENV=production
WATCHUP_EVENT_STORE=postgres
WATCHUP_API_HOST=0.0.0.0
WATCHUP_API_PORT=8769
WATCHUP_PARENTS_FILE=/run/secrets/watchup_parents.json
WATCHUP_SESSION_SECRET_FILE=/run/secrets/watchup_session_secret
# POC only: password login for one owner. Set true before any external pilot.
WATCHUP_REQUIRE_TOTP=false
WATCHUP_SESSION_TTL_SECONDS=2592000
WATCHUP_WEBHOOK_SECRET_FILE=/run/secrets/watchup_webhook_secret
WATCHUP_TENANT_ID=
WATCHUP_CHILD_ID=
WATCHUP_DB_HOST=watchup-postgres
WATCHUP_DB_PORT=5432
WATCHUP_DB_NAME=
WATCHUP_DB_USER=
WATCHUP_DB_PASSWORD_FILE=/run/secrets/watchup_db_password
WATCHUP_DB_SSLMODE=verify-full
WATCHUP_DB_SSLROOTCERT=/run/secrets/watchup_db_ca.crt
WATCHUP_RETENTION_DAYS=14
# Set only for the scheduled retention container/job; it exits after purging expired events.
WATCHUP_RUN_RETENTION_ONCE=0
# Leave empty unless requests can arrive through these exact reverse-proxy addresses.
WATCHUP_TRUSTED_PROXY_IPS=
